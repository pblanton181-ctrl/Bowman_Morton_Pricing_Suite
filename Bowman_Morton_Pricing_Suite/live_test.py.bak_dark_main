            cell_bold = ParagraphStyle('CellBodyBold', parent=styles['Normal'], fontName='Helvetica-Bold', fontSize=10, textColor=colors.HexColor('#263e63'))
            summary_label_style = ParagraphStyle('SummaryLabel', parent=styles['Normal'], fontName='Helvetica-Bold', fontSize=10, textColor=colors.HexColor('#475569'), alignment=2)
            summary_val_style = ParagraphStyle('SummaryVal', parent=styles['Normal'], fontName='Helvetica-Bold', fontSize=10, textColor=colors.HexColor('#263e63'))
