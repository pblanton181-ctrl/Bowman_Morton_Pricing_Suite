    def _build_tk_annotate(self):
        w = QWidget(); hl = QHBoxLayout(w); hl.setContentsMargins(0, 0, 0, 0); hl.setSpacing(4)
        g1, r1 = self._group("Typography & Pen Color")
        fc = QVBoxLayout(); fc.setContentsMargins(2, 2, 2, 2); fc.setSpacing(4)
        ft = QHBoxLayout(); ft.setContentsMargins(0, 0, 0, 0); ft.setSpacing(4)
        self.rib_font_cb = QFontComboBox()
        self.rib_font_cb.setFontFilters(QFontComboBox.ScalableFonts)
        self.rib_font_cb.setCurrentFont(QFont("Arial"))
        self.rib_font_cb.setFixedHeight(23); self.rib_font_cb.setFixedWidth(135)
        self.rib_font_cb.view().setFont(QFont("Segoe UI", 10))
        self.rib_font_cb.setStyleSheet("QFontComboBox { background-color: #ffffff; color: #0f172a; border: 1px solid #cbd5e1; border-radius: 4px; padding: 1px 6px; font-family: 'Segoe UI'; font-size: 11.5px; }")
        self.rib_font_cb.currentFontChanged.connect(lambda f: self._set_vw_font(f)); ft.addWidget(self.rib_font_cb)

        self.rib_font_sz = QSpinBox(); self.rib_font_sz.setRange(8, 72); self.rib_font_sz.setValue(18); self.rib_font_sz.setSuffix(" pt"); self.rib_font_sz.setFixedSize(64, 23)
        self.rib_font_sz.setStyleSheet("QSpinBox { background-color: #ffffff; color: #0f172a; border: 1px solid #cbd5e1; border-radius: 4px; padding: 1px 4px; font-size: 11.5px; }")
        self.rib_font_sz.valueChanged.connect(lambda v: self._set_vw_prop("font_size_spin", v)); ft.addWidget(self.rib_font_sz)

        self.rib_line_w = QDoubleSpinBox(); self.rib_line_w.setRange(0.5, 12.0); self.rib_line_w.setSingleStep(0.5); self.rib_line_w.setValue(2.0); self.rib_line_w.setSuffix(" px"); self.rib_line_w.setFixedSize(64, 23)
        self.rib_line_w.setStyleSheet("QDoubleSpinBox { background-color: #ffffff; color: #0f172a; border: 1px solid #cbd5e1; border-radius: 4px; padding: 1px 4px; font-size: 11.5px; }")
        self.rib_line_w.valueChanged.connect(lambda v: self._set_vw_prop("line_width_spin", v)); ft.addWidget(self.rib_line_w)
        fc.addLayout(ft)

        fb = QHBoxLayout(); fb.setContentsMargins(0, 0, 0, 0); fb.setSpacing(4)
        self._biu_btns = {}
        for lbl_bi, slot_bi, extra_css in [("B", self._toggle_bold, "font-weight: 700;"), ("I", self._toggle_italic, "font-style: italic;"), ("U", self._toggle_underline, "text-decoration: underline;")]:
            b_bi = QPushButton(lbl_bi); b_bi.setFixedSize(22, 22); b_bi.setCursor(Qt.PointingHandCursor); b_bi.setProperty("extra_css", extra_css); b_bi.clicked.connect(slot_bi); fb.addWidget(b_bi); self._biu_btns[lbl_bi] = b_bi
        self._refresh_biu_styles()

        self._swatch_btns.clear()
        for hx, s_tip in [("#111827", "Black"), ("#dc2626", "Red"), ("#0284c7", "Blue"), ("#059669", "Green"), ("#ea580c", "Orange"), ("#7c3aed", "Purple"), ("#eab308", "Yellow"), ("#ffffff", "White")]:
            sw = QPushButton(""); sw.setFixedSize(17, 17); sw.setCursor(Qt.PointingHandCursor); sw.setToolTip(s_tip); sw.clicked.connect(lambda _=False, c=hx: self._set_vw_color(c)); fb.addWidget(sw); self._swatch_btns[hx] = sw
        self._refresh_swatch_styles("#111827")

        b_wheel = QPushButton("+"); b_wheel.setFixedSize(20, 20); b_wheel.setCursor(Qt.PointingHandCursor); b_wheel.setToolTip("Custom Color")
        b_wheel.setStyleSheet("QPushButton { background-color: #ffffff !important; border: 1px solid #94a3b8 !important; color: #0f172a !important; font-size: 11px !important; font-weight: 700 !important; border-radius: 3px; padding: 0px !important; }")
        b_wheel.clicked.connect(self._pick_ribbon_color_before_use); fb.addWidget(b_wheel)
        fc.addLayout(fb); r1.addLayout(fc); hl.addWidget(g1)

        g2, r2 = self._group("Markup Shapes & Pens")
        r2.addWidget(self._mode_tile("cloud", "Revision\nCloud", "cloud"))
        r2.addWidget(self._mode_tile("highlight", "Highlight\nBox", "box"))
        r2.addWidget(self._mode_tile("filled_box", "Whiteout\nBox", "filled_box"))
        r2.addLayout(self._stack3([("Circle / Ring", "circle", lambda: self._vis_mode("ellipse")), ("Leader Arrow (A)", "arrow", lambda: self._vis_mode("arrow")), ("Review Stamp", "stamp", self._stamp_review_note)]))
        r2.addLayout(self._stack3([("Black Pen", "line", lambda: self._arm_pen("#111827", "line")), ("Red Markup Pen", "arrow", lambda: self._arm_pen("#dc2626", "arrow")), ("Yellow Highlighter", "box", lambda: self._arm_pen("#eab308", "highlight"))]))
        hl.addWidget(g2)

        g3, r3 = self._group("Bluebeam Tool Chest")
        r3.addLayout(self._stack3([("W-Beam Span Preset", "dim", lambda: self._apply_tool_chest("#0284c7", 2.5, "measure")), ("HSS Column Tag Preset", "count", lambda: self._apply_tool_chest("#059669", 2.0, "count")), ("Field Weld Note Preset", "weld", lambda: self._apply_tool_chest("#dc2626", 2.0, "weld"))]))
        hl.addWidget(g3); return w

