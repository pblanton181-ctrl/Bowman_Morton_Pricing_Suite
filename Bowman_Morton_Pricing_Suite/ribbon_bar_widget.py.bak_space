def _pen_icon(nib_hex, is_highlighter=False):
    pm = QPixmap(28, 28); pm.fill(Qt.transparent)
    p = QPainter(pm); p.setRenderHint(QPainter.Antialiasing)
    p.setPen(QPen(QColor("#334155"), 1.5, Qt.SolidLine, Qt.RoundCap, Qt.RoundJoin))
    p.drawRoundedRect(10, 12, 8, 12, 1.5, 1.5)
    p.setBrush(QColor(nib_hex)); p.setPen(QPen(QColor(nib_hex), 1.5, Qt.SolidLine, Qt.RoundCap, Qt.RoundJoin))
    if is_highlighter:
        p.drawPolygon([QPoint(10, 12), QPoint(18, 12), QPoint(16, 5), QPoint(12, 7)])
    else:
        p.drawPolygon([QPoint(10, 12), QPoint(18, 12), QPoint(14, 4)])
    p.end(); return QIcon(pm)


def _icon(kind, hex_color="#1e293b"):
    pm = QPixmap(28, 28); pm.fill(Qt.transparent)
    p = QPainter(pm); p.setRenderHint(QPainter.Antialiasing)
    ink = QColor("#1e293b"); acc = QColor("#0284c7"); tint = QColor(2, 132, 199, 28)
    red = QColor("#dc2626"); grn = QColor("#059669")
    p.setPen(QPen(ink, 1.5, Qt.SolidLine, Qt.RoundCap, Qt.RoundJoin))

    if kind == "folder":
        p.setBrush(tint); p.drawPolygon([QPoint(3, 7), QPoint(10, 7), QPoint(13, 10), QPoint(25, 10), QPoint(25, 23), QPoint(3, 23)])
        p.setPen(QPen(acc, 1.5)); p.drawLine(3, 13, 25, 13)
    elif kind == "new":
        p.drawRoundedRect(6, 3, 16, 22, 2, 2); p.setPen(QPen(acc, 1.8)); p.drawLine(14, 10, 14, 18); p.drawLine(10, 14, 18, 14)
    elif kind == "pdf":
        p.drawRoundedRect(6, 3, 16, 22, 2, 2); p.setBrush(red); p.setPen(Qt.NoPen); p.drawRect(6, 16, 16, 6)
        p.setPen(QPen(ink, 1.4)); p.drawLine(9, 8, 19, 8); p.drawLine(9, 12, 16, 12)
    elif kind == "print":
        p.drawRect(8, 3, 12, 6); p.setBrush(tint); p.drawRoundedRect(4, 9, 20, 10, 2, 2); p.setBrush(QColor("#ffffff")); p.drawRect(8, 16, 12, 9)
    elif kind == "export":
        p.drawRoundedRect(5, 14, 18, 10, 2, 2); p.setPen(QPen(acc, 1.8)); p.drawLine(14, 18, 14, 4); p.drawLine(9, 9, 14, 4); p.drawLine(19, 9, 14, 4)
    elif kind == "hand":
        p.setBrush(tint); p.drawRoundedRect(8, 11, 12, 12, 3, 3)
        for fx in (9, 12, 16, 19): p.drawLine(fx, 5, fx, 11)
    elif kind == "fit":
        p.setPen(QPen(acc, 1.7))
        p.drawLine(4, 9, 4, 4); p.drawLine(4, 4, 9, 4); p.drawLine(19, 4, 24, 4); p.drawLine(24, 4, 24, 9)
        p.drawLine(4, 19, 4, 24); p.drawLine(4, 24, 9, 24); p.drawLine(19, 24, 24, 24); p.drawLine(24, 24, 24, 19)
    elif kind == "dim":
        p.drawLine(4, 6, 4, 22); p.drawLine(24, 6, 24, 22); p.setPen(QPen(acc, 1.8)); p.drawLine(4, 14, 24, 14)
        p.drawLine(2, 17, 6, 11); p.drawLine(22, 17, 26, 11)
    elif kind == "angle":
        p.drawLine(4, 22, 24, 22); p.drawLine(4, 22, 21, 5); p.setPen(QPen(acc, 1.7)); p.drawArc(2, 11, 18, 18, 0, 45 * 16)
    elif kind == "count":
        p.setBrush(tint); p.setPen(QPen(grn, 1.6)); p.drawEllipse(6, 4, 16, 16); p.drawLine(14, 8, 14, 16); p.drawLine(10, 12, 18, 12)
    elif kind == "weld":
        p.drawLine(4, 22, 11, 14); p.drawLine(11, 14, 25, 14); p.setBrush(tint); p.setPen(QPen(acc, 1.6)); p.drawPolygon([QPoint(14, 14), QPoint(14, 6), QPoint(22, 14)])
    elif kind == "grid":
        p.setPen(QPen(acc, 1.6)); p.drawEllipse(6, 6, 16, 16); p.drawLine(11, 18, 14, 10); p.drawLine(14, 10, 17, 18); p.drawLine(12, 15, 16, 15)
    elif kind == "callout":
        p.setBrush(tint); p.drawRoundedRect(10, 4, 15, 11, 2, 2); p.drawLine(10, 10, 4, 23)
    elif kind == "text":
        p.setPen(QPen(ink, 2.0)); p.drawLine(7, 6, 21, 6); p.drawLine(14, 6, 14, 22); p.drawLine(10, 22, 18, 22)
    elif kind == "cloud":
        p.setPen(QPen(red, 1.6)); p.drawArc(4, 8, 9, 9, 0, 180 * 16); p.drawArc(11, 5, 10, 10, 0, 180 * 16); p.drawArc(16, 9, 8, 8, 270 * 16, 180 * 16); p.drawArc(5, 11, 16, 9, 180 * 16, 180 * 16)
    elif kind == "poly":
        p.setBrush(tint); p.setPen(QPen(acc, 1.6)); p.drawPolygon([QPoint(5, 6), QPoint(22, 4), QPoint(24, 20), QPoint(7, 23)])
    elif kind == "arrow":
        p.setPen(QPen(red, 1.8)); p.drawLine(5, 23, 23, 5); p.drawLine(14, 5, 23, 5); p.drawLine(23, 5, 23, 14)
    elif kind == "line":
        p.setPen(QPen(ink, 1.8)); p.drawLine(5, 23, 23, 5)
    elif kind == "dashed":
        p.setPen(QPen(acc, 1.6, Qt.DashLine)); p.drawLine(4, 14, 24, 14)
    elif kind == "box":
        p.setBrush(tint); p.drawRoundedRect(5, 6, 18, 16, 2, 2)
    elif kind == "filled_box":
        p.setBrush(QColor("#ffffff")); p.drawRoundedRect(5, 6, 18, 16, 2, 2); p.drawLine(5, 12, 23, 12); p.drawLine(5, 17, 23, 17)
    elif kind == "circle":
        p.setPen(QPen(acc, 1.6)); p.drawEllipse(5, 5, 18, 18)
    elif kind == "cursor":
        p.setBrush(QColor("#ffffff")); p.drawPolygon([QPoint(7, 4), QPoint(7, 21), QPoint(12, 17), QPoint(16, 24), QPoint(19, 23), QPoint(15, 15), QPoint(21, 15)])
    elif kind == "dup":
        p.drawRoundedRect(4, 8, 13, 15, 1.5, 1.5); p.setBrush(QColor("#ffffff")); p.drawRoundedRect(10, 4, 13, 15, 1.5, 1.5)
    elif kind == "rotate":
        p.setPen(QPen(acc, 1.7)); p.drawArc(5, 5, 18, 18, 30 * 16, 280 * 16); p.drawLine(19, 5, 24, 9); p.drawLine(19, 5, 16, 9)
    elif kind == "undo":
        p.setPen(QPen(acc, 1.8)); p.drawArc(6, 10, 16, 12, 0, 180 * 16); p.drawLine(6, 15, 3, 11); p.drawLine(6, 15, 10, 11)
    elif kind == "trash":
        p.setPen(QPen(red, 1.6)); p.drawLine(6, 7, 22, 7); p.drawRoundedRect(8, 7, 12, 16, 1.5, 1.5); p.drawLine(11, 4, 17, 4)
    elif kind == "eraser":
        p.setBrush(tint); p.drawPolygon([QPoint(5, 19), QPoint(15, 8), QPoint(23, 15), QPoint(13, 23), QPoint(5, 23)])
    elif kind == "stamp":
        p.setBrush(tint); p.drawRoundedRect(5, 18, 18, 5, 1.5, 1.5); p.drawRoundedRect(10, 6, 8, 12, 1.5, 1.5)
    elif kind == "add":
        p.setPen(QPen(grn, 1.8)); p.drawEllipse(5, 5, 18, 18); p.drawLine(14, 9, 14, 19); p.drawLine(9, 14, 19, 14)
    elif kind == "check":
        p.setBrush(tint); p.setPen(QPen(grn, 1.8)); p.drawRoundedRect(5, 5, 18, 18, 3, 3); p.drawLine(9, 14, 13, 18); p.drawLine(13, 18, 20, 10)
    elif kind == "excel":
        p.setPen(QPen(grn, 1.6)); p.drawRoundedRect(5, 5, 18, 18, 2, 2); p.drawLine(5, 11, 23, 11); p.drawLine(5, 17, 23, 17); p.drawLine(11, 5, 11, 23)
    elif kind == "calc":
        p.drawRoundedRect(6, 3, 16, 22, 2, 2); p.setBrush(tint); p.drawRect(9, 6, 10, 5)
    elif kind == "code":
        p.setPen(QPen(acc, 1.8)); p.drawLine(10, 8, 5, 14); p.drawLine(5, 14, 10, 20); p.drawLine(18, 8, 23, 14); p.drawLine(23, 14, 18, 20)
    elif kind == "search":
        p.setPen(QPen(acc, 1.7)); p.drawEllipse(5, 5, 13, 13); p.drawLine(16, 16, 23, 23)
    else:
        p.setBrush(tint); p.drawRoundedRect(5, 5, 18, 18, 2, 2)
    p.end(); return QIcon(pm)


def _win_caption_icon(kind, color_hex="#1f2937"):
    pm = QPixmap(16, 16); pm.fill(Qt.transparent)
    p = QPainter(pm); p.setRenderHint(QPainter.Antialiasing, False)
    p.setPen(QPen(QColor(color_hex), 1.2))
    if kind == "min": p.drawLine(3, 8, 13, 8)
    elif kind == "max": p.drawRect(3, 3, 9, 9)
    elif kind == "restore": p.drawRect(5, 2, 8, 8); p.drawRect(2, 5, 8, 8)
    elif kind == "close":
        p.setRenderHint(QPainter.Antialiasing, True)
        p.drawLine(4, 4, 12, 12); p.drawLine(12, 4, 4, 12)
    p.end(); return QIcon(pm)

class _QuickEstimatorCalcDialog(QDialog):
    def __init__(self, parent=None):
        super().__init__(parent)
        self.setWindowTitle("Quick Shop & Structural Calculator"); self.setFixedSize(310, 350)
        self.setStyleSheet("QDialog { background-color: #f8fafc; border: 1px solid #cbd5e1; } QLineEdit { background-color: #ffffff; color: #0f172a; border: 1px solid #94a3b8; border-radius: 5px; padding: 6px 8px; font-size: 18px; font-weight: 700; } QPushButton { background-color: #ffffff; border: 1px solid #cbd5e1; color: #0f172a; font-size: 14px; font-weight: 600; border-radius: 5px; padding: 6px; } QPushButton:hover { background-color: #e0f2fe; border-color: #0284c7; }")
        lay = QVBoxLayout(self); lay.setContentsMargins(12, 12, 12, 12); lay.setSpacing(8)
        self.disp = QLineEdit(); self.disp.setAlignment(Qt.AlignRight); self.disp.setPlaceholderText("0"); self.disp.returnPressed.connect(self._eval); lay.addWidget(self.disp)
        grid = QGridLayout(); grid.setSpacing(5)
        for txt, r, c in [("7",0,0),("8",0,1),("9",0,2),("/",0,3),("4",1,0),("5",1,1),("6",1,2),("*",1,3),("1",2,0),("2",2,1),("3",2,2),("-",2,3),("0",3,0),(".",3,1),("C",3,2),("+",3,3)]:
            b = QPushButton(txt)
            if txt == "C": b.clicked.connect(self.disp.clear)
            else: b.clicked.connect(lambda _=False, t=txt: self.disp.setText(self.disp.text() + t))
            grid.addWidget(b, r, c)
        lay.addLayout(grid, 1)
        eq_btn = QPushButton("= Compute"); eq_btn.clicked.connect(self._eval); lay.addWidget(eq_btn)

    def _eval(self):
        expr = self.disp.text().strip().replace("x", "*").replace("X", "*")
        if expr and all(ch in "0123456789.+-*/() " for ch in expr):
            try:
                res = eval(expr, {"__builtins__": None}, {})
                self.disp.setText(f"{res:,.4f}".rstrip("0").rstrip(".") if isinstance(res, float) else str(res))
            except Exception: self.disp.setText("Error")


class FloatingSteelToolPalette(QFrame):
    def __init__(self, ribbon_bar, parent=None):
        super().__init__(parent)
        self.rb = ribbon_bar; self._drag_pt = None; self._minimized = False
        self.setWindowFlags(Qt.Tool | Qt.FramelessWindowHint)
        self.setStyleSheet("QFrame { background-color: #f8fafc; border: 1px solid #94a3b8; border-radius: 6px; } QLabel#PalTitle { color: #0f172a; font-size: 11.5px; font-weight: 700; background: transparent; border: none; } QPushButton { background-color: #ffffff; color: #1e293b; border: 1px solid #cbd5e1; border-radius: 4px; font-size: 11.5px; font-weight: 500; padding: 5px 10px; text-align: left; } QPushButton:hover { background-color: #e0f2fe; border-color: #0284c7; color: #0369a1; }")
        lay = QVBoxLayout(self); lay.setContentsMargins(6, 5, 6, 6); lay.setSpacing(4)
        hdr = QHBoxLayout(); hdr.setContentsMargins(0, 0, 0, 0)
        ttl = QLabel("BM CAD Tool Palette"); ttl.setObjectName("PalTitle"); hdr.addWidget(ttl); hdr.addStretch()
        self.btn_min = QPushButton("_"); self.btn_min.setFixedSize(20, 18); self.btn_min.clicked.connect(self._toggle_min)
        btn_x = QPushButton("x"); btn_x.setFixedSize(20, 18); btn_x.clicked.connect(self.hide)
        hdr.addWidget(self.btn_min); hdr.addWidget(btn_x); lay.addLayout(hdr)
        self.body = QWidget(); bl = QVBoxLayout(self.body); bl.setContentsMargins(0, 2, 0, 0); bl.setSpacing(3)
        for lbl, ic, fn in [("Linear Dim (M)", "dim", lambda: self.rb._vis_mode("measure")), ("Angle / Slope", "angle", lambda: self.rb._vis_mode("angle")), ("Count Tag (C)", "count", lambda: self.rb._vis_mode("count")), ("Weld Symbol (W)", "weld", lambda: self.rb._vis_mode("weld")), ("Grid Bubble (G)", "grid", lambda: self.rb._vis_mode("grid_bubble")), ("Callout Box (Q)", "callout", lambda: self.rb._vis_mode("callout")), ("Rev Cloud (R)", "cloud", lambda: self.rb._vis_mode("cloud")), ("W-Beam Member", "add", lambda: self.rb._jump_shape_and_profile("beam", "")), ("HSS Tube Member", "box", lambda: self.rb._jump_shape_and_profile("hss_tube", "")), ("Plate / Gusset", "filled_box", lambda: self.rb._jump_shape_and_profile("plate", "")), ("Trig & Roof Pitch", "calc", lambda: self.rb._open_trig_studio(0))]:
            b = QPushButton("  " + lbl); b.setIcon(_icon(ic)); b.setIconSize(QSize(15, 15)); b.setCursor(Qt.PointingHandCursor); b.clicked.connect(fn); bl.addWidget(b)
        lay.addWidget(self.body); self.adjustSize()

    def _toggle_min(self): self._minimized = not self._minimized; self.body.setVisible(not self._minimized); self.adjustSize()
    def mousePressEvent(self, ev):
        if ev.button() == Qt.LeftButton and ev.position().y() <= 26: self._drag_pt = ev.globalPosition().toPoint() - self.frameGeometry().topLeft()
        super().mousePressEvent(ev)
    def mouseMoveEvent(self, ev):
        if self._drag_pt is not None and (ev.buttons() & Qt.LeftButton): self.move(ev.globalPosition().toPoint() - self._drag_pt)
        super().mouseMoveEvent(ev)
    def mouseReleaseEvent(self, ev): self._drag_pt = None; super().mouseReleaseEvent(ev)

class BowmanMortonRibbonBar(QFrame):
    def __init__(self, app_win, parent=None):
        super().__init__(parent)
        self.app = app_win; self._collapsed = False; self._active_color_hex = "#111827"
        self._swatch_btns = {}; self._mode_widgets = {}; self._tab_btns = []; self._ws_btns = []
        self._active_ws = 0; self._active_subtab = 0
        self.setObjectName("OfficeGreyRibbon"); self.setAttribute(Qt.WA_StyledBackground, True)
        self.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Fixed)
        self.setMinimumHeight(156); self.setMaximumHeight(156)
        self.setStyleSheet("""
            QFrame#OfficeGreyRibbon { background-color: #e2e8f0; border: none; border-bottom: 1px solid #cbd5e1; }
            QFrame#OfficeCommandBand { background-color: #ffffff; border: 1px solid #cbd5e1; border-radius: 6px; margin: 0px 8px 5px 8px; }
            QFrame#OfficeGroup { background: transparent; border: none; border-right: 1px solid #e2e8f0; }
            QFrame#ContextualSelectionGroup { background-color: #f0f9ff; border: 1px solid #38bdf8; border-radius: 5px; }
            QLabel#OfficeGroupCap { color: #64748b; background: transparent; font-size: 10px; font-weight: 600; border: none; padding: 0px 4px; }
            QLabel#CtxGroupCap { color: #0284c7; background: transparent; font-size: 10px; font-weight: 700; border: none; padding: 0px 4px; }
        """)
        outer = QVBoxLayout(self); outer.setContentsMargins(0, 0, 0, 0); outer.setSpacing(0)

        title_bar = QFrame(); title_bar.setFixedHeight(32); title_bar.setStyleSheet("QFrame { background-color: #e2e8f0; border: none; }")
        tr = QHBoxLayout(title_bar); tr.setContentsMargins(10, 0, 0, 0); tr.setSpacing(4)
        for q_tip, q_ic, q_slot in [("Open PDF Planset", "folder", self._act_load_pdf), ("Undo Markup (Ctrl+Z)", "undo", lambda: self._canvas_call("undo_last_markup")), ("Export Marked PDF", "export", lambda: self._vis_click("btn_print_pdf")), ("Shop Calculator", "calc", self._act_calc)]:
            qb = QToolButton(); qb.setIcon(_icon(q_ic)); qb.setIconSize(QSize(14, 14)); qb.setToolTip(q_tip); qb.setCursor(Qt.PointingHandCursor); qb.setFixedSize(24, 24)
            qb.setStyleSheet("QToolButton { background: transparent; border: none; border-radius: 4px; } QToolButton:hover { background-color: #cbd5e1; }")
            qb.clicked.connect(q_slot); tr.addWidget(qb)
        tr.addSpacing(8)
        brand = QLabel("BOWMAN MORTON")
        brand.setStyleSheet("color: #0f172a; font-size: 11.5px; font-weight: 800; background: transparent;")
        tr.addWidget(brand); tr.addSpacing(10)

        ws_pill = QFrame(); ws_pill.setStyleSheet("QFrame { background-color: #cbd5e1; border-radius: 5px; padding: 1px; }")
        wsl = QHBoxLayout(ws_pill); wsl.setContentsMargins(2, 2, 2, 2); wsl.setSpacing(2)
        for idx, w_name in enumerate(["Takeoff", "Catalog", "Structural", "Ledger", "Admin"]):
            wb_s = QPushButton(w_name); wb_s.setCursor(Qt.PointingHandCursor); wb_s.setFixedHeight(21)
            wb_s.clicked.connect(lambda _=False, i=idx: self._switch_workspace(i))
            wsl.addWidget(wb_s); self._ws_btns.append(wb_s)
        tr.addWidget(ws_pill); tr.addStretch(1)

        self.search_box = QLineEdit()
        self.search_box.setPlaceholderText("Command (Ctrl+K): DIM, WELD, W12X26, BABU, or 14.5*26*1.30...")
        self.search_box.setFixedHeight(22); self.search_box.setMinimumWidth(290); self.search_box.setMaximumWidth(390)
        self.search_box.setStyleSheet("QLineEdit { background-color: #ffffff; color: #0f172a; border: 1px solid #94a3b8; border-radius: 4px; padding: 1px 10px; font-size: 11.5px; } QLineEdit:focus { border: 1.5px solid #0284c7; }")
        self.search_box.returnPressed.connect(self._on_quick_search)
        QShortcut(QKeySequence("Ctrl+K"), self.app, activated=self.search_box.setFocus)
        tr.addWidget(self.search_box); tr.addStretch(1)

        for kind, tip, slot, is_close in [("min", "Minimize", lambda: self.app.showMinimized(), False), ("max", "Maximize / Restore", self._toggle_max, False), ("close", "Close", lambda: self.app.close(), True)]:
            wb = QPushButton(""); wb.setIcon(_win_caption_icon(kind, "#1f2937")); wb.setIconSize(QSize(14, 14)); wb.setToolTip(tip); wb.setFixedSize(44, 30)
            h_bg = "#e81123" if is_close else "#cbd5e1"
            wb.setStyleSheet(f"QPushButton {{ background: transparent !important; border: none !important; border-radius: 0px; padding: 0px; }} QPushButton:hover {{ background-color: {h_bg} !important; }}")
            wb.clicked.connect(slot); tr.addWidget(wb)
            if kind == "max": self.btn_max = wb; wb.setIcon(_win_caption_icon("restore" if self.app.isMaximized() else "max", "#1f2937"))
            elif is_close:
                wb.enterEvent = lambda _e, b=wb: b.setIcon(_win_caption_icon("close", "#ffffff"))
                wb.leaveEvent = lambda _e, b=wb: b.setIcon(_win_caption_icon("close", "#1f2937"))
        outer.addWidget(title_bar)
        tab_strip = QFrame(); tab_strip.setFixedHeight(28); tab_strip.setStyleSheet("QFrame { background-color: #e2e8f0; border: none; }")
        self.tab_row = QHBoxLayout(tab_strip); self.tab_row.setContentsMargins(10, 2, 10, 0); self.tab_row.setSpacing(2)
        for idx in range(5):
            tb = QPushButton(""); tb.setCursor(Qt.PointingHandCursor); tb.setFixedHeight(24)
            tb.clicked.connect(lambda _=False, i=idx: self._switch_subtab(i))
            self.tab_row.addWidget(tb); self._tab_btns.append(tb)

        self.tab_row.addSpacing(10)
        self.lbl_live_telemetry = QLabel("Armed: Hand Pan  |  Scale: 1/4\" = 1'-0\"")
        self.lbl_live_telemetry.setStyleSheet("color: #0369a1; background-color: #f8fafc; border: 1px solid #cbd5e1; border-radius: 9px; padding: 1px 10px; font-size: 10.5px; font-weight: 600;")
        self.tab_row.addWidget(self.lbl_live_telemetry); self.tab_row.addStretch()

        self.btn_pin = QPushButton("Collapse"); self.btn_pin.setCursor(Qt.PointingHandCursor); self.btn_pin.setFixedHeight(22)
        self.btn_pin.setStyleSheet("QPushButton { background: transparent !important; border: none !important; color: #334155 !important; font-size: 11px; font-weight: 600; padding: 0px 8px !important; } QPushButton:hover { background-color: #cbd5e1 !important; border-radius: 4px; }")
        self.btn_pin.clicked.connect(self._toggle_collapse); self.tab_row.addWidget(self.btn_pin)
        outer.addWidget(tab_strip)

        self.cmd_band = QFrame(); self.cmd_band.setObjectName("OfficeCommandBand"); self.cmd_band.setAttribute(Qt.WA_StyledBackground, True)
        self.band_layout = QHBoxLayout(self.cmd_band); self.band_layout.setContentsMargins(6, 2, 6, 2); self.band_layout.setSpacing(4)

        self.ctx_stack = QStackedWidget(); self.ctx_stack.setStyleSheet("background: transparent; border: none;")
        self.ctx_stack.setSizePolicy(QSizePolicy.Maximum, QSizePolicy.Preferred)
        self._ws_subtabs = {
            0: [("Home", self._build_tk_home), ("Annotate & Markup", self._build_tk_annotate), ("Measure & Scale", self._build_tk_measure), ("View & Layers", self._build_tk_view), ("Tools & Math", self._build_tools_strip)],
            1: [("Home", self._build_catalog_strip), ("Tiers & Output", self._build_catalog_out), ("Tools & Math", self._build_tools_strip)],
            2: [("Home", self._build_structural_strip), ("Quick Shapes & Finish", self._build_struct_shapes), ("Tools & Math", self._build_tools_strip)],
            3: [("Home", self._build_ledger_strip), ("Tools & Math", self._build_tools_strip)],
            4: [("Home", self._build_admin_strip), ("Tools & Math", self._build_tools_strip)],
        }
        self._page_map = {}
        for ws_i, tabs_spec in self._ws_subtabs.items():
            for st_i, (_, builder_fn) in enumerate(tabs_spec):
                self._page_map[(ws_i, st_i)] = self.ctx_stack.addWidget(builder_fn())
        self.band_layout.addWidget(self.ctx_stack, 0, Qt.AlignLeft)

        self.grp_selected_ctx, r_sel = self._group("Selected Markup", contextual=True)
        self.lbl_sel_type = QLabel("None")
        self.lbl_sel_type.setStyleSheet("color: #0284c7; font-size: 10.5px; font-weight: 700; padding: 0px 4px;")
        sel_col = QVBoxLayout(); sel_col.setContentsMargins(2, 1, 2, 1); sel_col.setSpacing(2); sel_col.addWidget(self.lbl_sel_type)
        sel_btns = QHBoxLayout(); sel_btns.setSpacing(3)
        for s_lbl, s_fn in [("Clone", lambda: self._canvas_call("duplicate_selected_markup")), ("Rotate", lambda: self._canvas_call("rotate_selected_markup")), ("Delete", lambda: self._canvas_call("delete_selected_markup"))]:
            sb = QPushButton(s_lbl); sb.setFixedHeight(21); sb.setCursor(Qt.PointingHandCursor)
            sb.setStyleSheet("QPushButton { background-color: #ffffff; border: 1px solid #7dd3fc; color: #0f172a; font-size: 10.5px; font-weight: 600; border-radius: 3px; padding: 0px 6px; } QPushButton:hover { background-color: #bae6fd; }")
            sb.clicked.connect(s_fn); sel_btns.addWidget(sb)
        sel_col.addLayout(sel_btns); r_sel.addLayout(sel_col)
        self.grp_selected_ctx.setVisible(False)
        self.band_layout.addWidget(self.grp_selected_ctx, 0, Qt.AlignLeft)
        self.band_layout.addStretch(1)
        outer.addWidget(self.cmd_band, 1)

        QTimer.singleShot(250, self._init_smart_completer)
        self.set_active_tab(0)
    def _group(self, title, contextual=False):
        box = QFrame()
        box.setObjectName("ContextualSelectionGroup" if contextual else "OfficeGroup")
        vl = QVBoxLayout(box); vl.setContentsMargins(6, 2, 8, 2); vl.setSpacing(2)
        row = QHBoxLayout(); row.setContentsMargins(0, 0, 0, 0); row.setSpacing(4); vl.addLayout(row, 1)
        lbl = QLabel(title); lbl.setObjectName("CtxGroupCap" if contextual else "OfficeGroupCap"); lbl.setAlignment(Qt.AlignCenter); vl.addWidget(lbl)
        return box, row

    def _tile(self, text, icon_name, slot):
        b = QToolButton(); b.setText(text); b.setIcon(_icon(icon_name)); b.setIconSize(QSize(24, 24))
        b.setToolButtonStyle(Qt.ToolButtonTextUnderIcon); b.setCursor(Qt.PointingHandCursor); b.setMinimumSize(68, 68)
        b.setStyleSheet("QToolButton { background: transparent; border: 1px solid transparent; border-radius: 4px; color: #0f172a; font-size: 11px; font-weight: 500; padding: 3px 6px; } QToolButton:hover { background-color: #e2e8f0; border: 1px solid #cbd5e1; }")
        b.clicked.connect(slot); return b

    def _mode_tile(self, mode_key, text, icon_name):
        b = self._tile(text, icon_name, lambda: self._vis_mode(mode_key))
        self._mode_widgets.setdefault(mode_key, []).append(b); return b

    def _menu_tile(self, text, icon_name, entries):
        b = QToolButton(); b.setText(text); b.setIcon(_icon(icon_name)); b.setIconSize(QSize(24, 24))
        b.setToolButtonStyle(Qt.ToolButtonTextUnderIcon); b.setCursor(Qt.PointingHandCursor); b.setMinimumSize(68, 68)
        b.setPopupMode(QToolButton.InstantPopup)
        b.setStyleSheet("QToolButton { background: transparent; border: 1px solid transparent; border-radius: 4px; color: #0f172a; font-size: 11px; font-weight: 500; padding: 3px 6px; } QToolButton:hover { background-color: #e2e8f0; border: 1px solid #cbd5e1; } QToolButton::menu-indicator { image: none; }")
        menu = QMenu(b); menu.setStyleSheet("QMenu { background-color: #ffffff; color: #0f172a; border: 1px solid #cbd5e1; padding: 4px; font-size: 11.5px; } QMenu::item { padding: 5px 14px 5px 8px; border-radius: 3px; } QMenu::item:selected { background-color: #e0f2fe; color: #0369a1; }")
        for label, ic, slot in entries: menu.addAction(_icon(ic), label).triggered.connect(slot)
        b.setMenu(menu); return b

    def _stack3(self, items):
        col = QVBoxLayout(); col.setContentsMargins(2, 1, 2, 1); col.setSpacing(2)
        for text, ic_name, slot in items:
            b = QPushButton(" " + text); b.setIcon(_icon(ic_name, "#1e293b")); b.setIconSize(QSize(14, 14)); b.setCursor(Qt.PointingHandCursor); b.setFixedHeight(21)
            b.setStyleSheet("QPushButton { background: transparent !important; border: 1px solid transparent !important; color: #1e293b !important; font-size: 11px !important; font-weight: 500 !important; border-radius: 3px; padding: 0px 6px; text-align: left; } QPushButton:hover { background-color: #e2e8f0 !important; border: 1px solid #cbd5e1 !important; }")
            b.clicked.connect(slot); col.addWidget(b)
        return col

