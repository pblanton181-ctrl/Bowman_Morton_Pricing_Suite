        self.btn_ep_snap = QPushButton("Snap"); self.btn_ep_snap.setCheckable(True); self.btn_ep_snap.setChecked(True); self.btn_ep_snap.setFixedSize(70, 23); self.btn_ep_snap.toggled.connect(self._toggle_endpoint_snap)
        snap_row.addWidget(self.btn_ortho_lock); snap_row.addWidget(self.btn_ep_snap)
