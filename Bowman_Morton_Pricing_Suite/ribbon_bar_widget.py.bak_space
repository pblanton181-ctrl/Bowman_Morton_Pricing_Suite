        r3.addLayout(self._stack3([("Undo (Ctrl+Z)", "undo", lambda: self._canvas_call("undo_last_markup")), ("Delete (Del)", "trash", lambda: self._canvas_call("delete_selected_markup")), ("Clear All Marks", "eraser", lambda: self._canvas_call("clear_markups"))]))
