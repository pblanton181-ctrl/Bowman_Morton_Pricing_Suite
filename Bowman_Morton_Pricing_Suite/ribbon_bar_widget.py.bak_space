        self.ribbon_scale_cb.setStyleSheet("QComboBox { background-color: #ffffff; color: #0f172a; border: 1px solid #cbd5e1; border-radius: 4px; padding: 1px 6px; font-size: 11.5px; }")
        for lbl_s, pts_s in [('1/8" = 1\'-0"', 9.0), ('3/16" = 1\'-0"', 13.5), ('1/4" = 1\'-0"', 18.0), ('3/8" = 1\'-0"', 27.0), ('1/2" = 1\'-0"', 36.0), ('3/4" = 1\'-0"', 54.0), ('1" = 1\'-0"', 72.0), ('1-1/2" = 1\'-0"', 108.0), ('3" = 1\'-0"', 216.0)]:
